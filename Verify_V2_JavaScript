````````````````` Send OTP `````````````````
var settings = {
  "url": "https://api.d7networks.com/verify/v2/otp/send-otp",
  "method": "POST",
  "timeout": 0,
  "headers": {
    "Authorization": "Bearer {{api_access_token}}",
    "Content-Type": "application/json"
  },
  "data": JSON.stringify({
    "recipient": "{{recipient1}}",
    "flow_id": "{{flow_id}}"
  }),
};

$.ajax(settings).done(function (response) {
  console.log(response);
});


