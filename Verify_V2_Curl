````````````````` Send OTP `````````````````
curl --location --request POST 'https://api.d7networks.com/verify/v2/otp/send-otp' \
--header 'Authorization: Bearer {{api_access_token}}' \
--header 'Content-Type: application/json' \
--data-raw '{
    "recipient": "{{recipient1}}",
    "flow_id": "{{flow_id}}"
}'



````````````````` Resend OTP `````````````````
curl --location --request POST 'https://api.d7networks.com/verify/v2/otp/resend-otp' \
--header 'Authorization: Bearer {{api_access_token}}' \
--header 'Content-Type: application/json' \
--data-raw '{
    "otp_id":"8d963dbf-d655-4fe6-9157-48885a036050"
}'


````````````````` Verify OTP `````````````````
curl --location --request POST 'https://api.d7networks.com/verify/v2/otp/verify-otp' \
--header 'Authorization: Bearer {{api_access_token}}' \
--header 'Content-Type: application/json' \
--data-raw '{
    "otp_id":"8d963dbf-d655-4fe6-9157-48885a036050",
